{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "cms/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "cms/src/app/api/$1"
    },
    {
      "src": "/admin(.*)",
      "dest": "cms"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
