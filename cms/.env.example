# Neon pooled connection string used by Payload at runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
# Direct Neon connection string used for schema migrations
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require
# Generate a unique secret, e.g. openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-secret
# Comma-separated allowed origins (include localhost during local development)
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
